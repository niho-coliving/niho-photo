{
  "contract": "niho.native-account",
  "version": 2,
  "consumers": ["photo", "docs"],
  "protocol": "niho-app-connect-v1",
  "clients": { "photo": "niho-camera", "docs": "niho-docs" },
  "connect": "https://niho.life/connect/<clientId>?v=1&challenge=<S256>&state=<random>",
  "callback": "<clientId>://auth?code=<one-use-code>&state=<random>",
  "pkce": "S256",
  "clientAuthentication": "none",
  "exchange": "POST /api/auth/app-connect/exchange",
  "exchangeFields": ["clientId", "code", "codeVerifier", "deviceName"],
  "identityExchange": "POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithCustomToken?key=<public-web-api-key>",
  "refresh": "POST /api/auth/app-connect/refresh",
  "identityConfirmation": "GET /api/auth/me",
  "firebaseRefreshToken": "discard",
  "connectionRefreshToken": "rotate-and-save-before-firebase-exchange",
  "pendingTtlMs": 600000,
  "pendingConsumption": "persist-before-code-exchange",
  "defaultProductionStateWithoutPublicConfig": "local_only",
  "localEditingRequiresLogin": false,
  "preDeveloperIdStorage": "app-data-0700-directory-0600-atomic-files",
  "runtimeTokenFilesInRepository": "forbidden",
  "clientRoleClaimsGrantAuthority": false,
  "errorCodes": ["not_configured", "invalid_config", "busy", "cancelled", "expired", "invalid_redirect", "invalid_state", "invalid_response", "rejected", "network", "paused", "account_unavailable", "browser", "storage", "internal"],
  "phases": ["local_only", "signed_out", "waiting", "refreshing", "connected", "offline", "failed"]
}
